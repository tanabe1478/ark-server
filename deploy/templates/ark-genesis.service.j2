[Unit]
Description=ARK Survival Evolved dedicated server
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory={{ ark_root_dir }}
ExecStart={{ ark_root_dir }}/scripts/start.sh
# Never replay an unreviewed crash; the controller owns readiness and restart.
Restart=no
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=180
LimitNOFILE=100000
UMask=0077

[Install]
WantedBy=default.target
